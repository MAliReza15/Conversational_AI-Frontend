# ──────────────────────────────────────────────
# Frontend Environment Variables (Remix Nurse AI)
# ──────────────────────────────────────────────
# Vite exposes only variables prefixed with VITE_

# ── Backend API Configuration ──
# Set these to your deployed backend URL on Vercel/production
# In development, the Vite proxy handles routing to localhost
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ── App Settings ──
VITE_PORT=5173
